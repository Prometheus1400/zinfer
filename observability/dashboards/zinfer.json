    {
      "id": 9,
      "title": "Prefill forward duration",
      "type": "timeseries",
      "description": "Median/p95 bucket-based estimates of prefill model forward wall time, including evaluation of sampled results. Excludes queueing, token delivery, and other-phase work; this is not HTTP request latency. Mean uses the raw observed duration sum/count, rather than interpolating histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "zinfer-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(zinfer_engine_forward_prefill_duration_seconds_bucket{job=\"zinfer\"}[$__rate_interval])))",
          "legendFormat": "Median",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zinfer_engine_forward_prefill_duration_seconds_bucket{job=\"zinfer\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(zinfer_engine_forward_prefill_duration_seconds_sum{job=\"zinfer\"}[$__rate_interval])) / (sum(rate(zinfer_engine_forward_prefill_duration_seconds_count{job=\"zinfer\"}[$__rate_interval])) > 0)",
          "legendFormat": "Mean",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "\u2014",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
