      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "zinfer_engine_output_tokens_total{job=\"zinfer\"}",
          "legendFormat": "Tokens",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "\u2014",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Forward calls with batching",
      "type": "stat",
      "description": "Fraction of recent forward calls containing multiple sequences, separately for prefill and decode. Blank while that phase is idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "zinfer-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(zinfer_engine_prefill_batch_size_count{job=\"zinfer\"}[$__rate_interval])) - sum(rate(zinfer_engine_prefill_batch_size_bucket{job=\"zinfer\",le=~\"1([.]0)?\"}[$__rate_interval]))) / (sum(rate(zinfer_engine_prefill_batch_size_count{job=\"zinfer\"}[$__rate_interval])) > 0)",
          "legendFormat": "Prefill",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(zinfer_engine_decode_batch_size_count{job=\"zinfer\"}[$__rate_interval])) - sum(rate(zinfer_engine_decode_batch_size_bucket{job=\"zinfer\",le=~\"1([.]0)?\"}[$__rate_interval]))) / (sum(rate(zinfer_engine_decode_batch_size_count{job=\"zinfer\"}[$__rate_interval])) > 0)",
          "legendFormat": "Decode",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "\u2014",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Prefill"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Decode"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Ready for decode$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "title": "Active requests and sequences",
      "type": "timeseries",
      "description": "HTTP requests include parsing, queueing, generation, and response writing. Phase gauges count distinct batcher-owned collections; ready sequences have finished prefill and await a decode slot. One-second scrapes can miss brief peaks.",
      "datasource": {
        "type": "prometheus",
        "uid": "zinfer-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "zinfer_http_requests_active{job=\"zinfer\"}",
          "legendFormat": "HTTP requests",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "zinfer_engine_prefill_sequences{job=\"zinfer\"}",
          "legendFormat": "Prefill batch",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "zinfer_engine_decode_sequences{job=\"zinfer\"}",
          "legendFormat": "Decode batch",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "zinfer_engine_decode_ready_sequences{job=\"zinfer\"}",
          "legendFormat": "Ready for decode",
          "range": true,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "\u2014",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
