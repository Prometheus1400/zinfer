            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Decode"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Ready for decode$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      }
    },
    {
      "id": 6,
      "title": "Average sequences per forward",
      "type": "timeseries",
      "description": "Mean sequences per actual model forward call, separately for prefill and decode. Decode counts successive token steps; prefill counts prompt passes. Blank while a phase is idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "zinfer-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(zinfer_engine_prefill_batch_size_sum{job=\"zinfer\"}[$__rate_interval])) / (sum(rate(zinfer_engine_prefill_batch_size_count{job=\"zinfer\"}[$__rate_interval])) > 0)",
          "legendFormat": "Prefill",
