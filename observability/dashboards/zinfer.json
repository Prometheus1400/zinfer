{
  "uid": "zinfer-engine",
  "title": "Zinfer Engine",
  "description": "Phase-specific engine and HTTP metrics. Prefill and decode have separate batch-size, duration, and emitted-output-token metrics. Monitoring history is temporary; engine counters reset when zinfer restarts.",
  "tags": [
    "zinfer",
    "inference"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 3,
  "editable": false,
  "refresh": "1s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s"
    ],
    "time_options": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Zinfer target",
      "type": "stat",
      "description": "Whether Prometheus can scrape the Zig server.",
      "datasource": {
        "type": "prometheus",
        "uid": "zinfer-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"zinfer\"}",
          "legendFormat": "Zinfer",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Engine completions",
      "type": "stat",
      "description": "Cumulative since the engine started, including requests before this monitoring session.",
      "datasource": {
        "type": "prometheus",
        "uid": "zinfer-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "zinfer-prometheus"
          },
          "editorMode": "code",
          "expr": "zinfer_engine_requests_completed_total{job=\"zinfer\"}",
          "legendFormat": "Completed",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "\u2014",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Engine output tokens",
      "type": "stat",
      "description": "Cumulative generated tokens since the engine started; excludes stop tokens.",
